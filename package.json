{
  "name": "raff",
  "version": "1.2.0",
  "description": "Raff — a clipboard shelf on the edge of your Mac screen. Based on Edge-Drop by Deepender25.",
  "author": {
    "name": "Mohamed Hassan",
    "url": "https://github.com/cdh30234"
  },
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github": "npm run build && electron-builder --win nsis -c.extraMetadata.buildTarget=github",
    "build:store": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:msix": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "postinstall": "install-electron",
    "build:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "release:mac": "sh scripts/release-mac.sh"
  },
  "build": {
    "appId": "com.mohamedhassan.raff",
    "productName": "Raff",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/renderer/**/*.gif",
      "!out/ts/**",
      "resources/**/*",
      "!resources/startup/**/*.exe",
      "!resources/startup/**/*.cs",
      "!resources/appx/**",
      "package.json",
      "!**/node_modules/emoji-datasource-twitter/**",
      "!**/node_modules/gsap/**",
      "!**/node_modules/framer-motion/**",
      "!**/node_modules/@fontsource/**",
      "!**/node_modules/@radix-ui/**",
      "!**/node_modules/svg-path-bbox/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/prism-react-renderer/**",
      "!**/node_modules/koffi/doc/**",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "node_modules/emoji-datasource-twitter/img/twitter/64",
        "to": "emoji/64"
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*",
      "**/node_modules/@resvg/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "cdh30234",
      "repo": "Raff",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "resources/startup/EdgeDropStartup.exe",
          "to": "startup/EdgeDropStartup.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Edge-Drop",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Edge-Drop-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "Deepender.EdgeDrop",
      "publisher": "CN=55FECDC4-7144-4A41-98FC-056C003F76FD",
      "publisherDisplayName": "Deepender",
      "applicationId": "EdgeDrop",
      "displayName": "Edge Drop",
      "capabilities": [
        "runFullTrust",
        "internetClient"
      ],
      "customExtensionsPath": "resources/appx/startup-extensions.xml"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "Raff-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSAccessibilityUsageDescription": "Raff presses Cmd+V for you to paste the item you clicked into the app you are using.",
        "NSAppleEventsUsageDescription": "Raff shows what Apple Music or Spotify is playing on its Home page and lets you play, pause and skip from there."
      }
    },
    "dmg": {
      "title": "Raff ${version}"
    },
    "copyright": "Copyright © 2026 Mohamed Hassan. Based on Edge-Drop © Deepender25 (Apache-2.0)."
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.11",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^2.1.0",
    "emoji-datasource-twitter": "^16.0.0",
    "framer-motion": "^11.0.24",
    "gsap": "^3.15.0",
    "prism-react-renderer": "^2.4.1",
    "react-dom": "^18.2.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "adhan": "^4.4.6",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "react": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "homepage": "https://github.com/cdh30234/Raff",
  "repository": {
    "type": "git",
    "url": "https://github.com/cdh30234/Raff.git"
  }
}
